# TalentSource-AI Environment Variables

# === AI & API ===
# Gemini API key for CV extraction, job analysis, and candidate matching
# Get from: https://ai.google.dev/
# Leave blank to use fallback (mock) responses
GEMINI_API_KEY=your_gemini_api_key_here

# === Deployment ===
# App URL (used for self-referential links, OAuth callbacks)
# Set automatically by Vercel; override if using custom domain
APP_URL=http://localhost:4000

# === Database (Supabase) — Phase 2+ ===
# Get from: https://supabase.com/ → Project Settings → API
# Leave blank until P2 (persistence layer) is connected
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === Optional: Analytics (Phase 6+) ===
# PLAUSIBLE_DOMAIN=your-domain.com
# SENTRY_DSN=your_sentry_dsn_here
